#!/usr/bin/env bash
# Pre-commit hook — mirrors the bacon jobs defined in bacon.toml:
#   fmt       → cargo fmt --all -- --check
#   build     → cargo build --all-targets
#   check-all → cargo check --all-targets
#   clippy    → cargo clippy --all-targets -- -D warnings
#   test      → cargo nextest run --all
# All steps must pass for the commit to proceed.
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

run() {
    local label="$1"; shift
    printf "${YELLOW}[pre-commit]${NC} %s\n" "$label"
    if "$@"; then
        printf "${GREEN}[pre-commit]${NC} ✓ %s\n" "$label"
    else
        printf "${RED}[pre-commit]${NC} ✗ %s failed — commit aborted\n" "$label"
        exit 1
    fi
}

# bacon job: fmt  (check only — does not modify files)
run "fmt" cargo fmt --all -- --check

# bacon job: build  (catches linker / codegen errors that check misses)
run "build" cargo build --all-targets

# bacon job: clippy
run "clippy" cargo clippy --all-targets -- -D warnings

# bacon job: test  (nextest as configured in .config/nextest.toml)
run "test" cargo nextest run --all

# shellcheck disable=SC2059
printf "${GREEN}[pre-commit]${NC} all checks passed.\n"
